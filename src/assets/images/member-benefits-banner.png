/**
 * Image asset management module
 * Centralizes image imports and provides type-safe access to image assets
 */

export interface ImageAsset {
  src: string;
  alt: string;
  width: number;
  height: number;
}

/**
 * Member benefits banner image configuration
 * @constant
 */
export const MEMBER_BENEFITS_BANNER: ImageAsset = {
  src: '/images/member-benefits-banner.png',
  alt: 'Member Benefits Banner - Exclusive rewards and perks for members',
  width: 1200,
  height: 300,
};

/**
 * All image assets used in the application
 */
export const IMAGE_ASSETS = {
  memberBenefitsBanner: MEMBER_BENEFITS_BANNER,
} as const;

export type ImageAssetKey = keyof typeof IMAGE_ASSETS;
```

**Option 3: React Component Wrapper**

