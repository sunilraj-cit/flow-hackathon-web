import Image from 'next/image';

interface MemberBenefitsBannerProps {
  className?: string;
  priority?: boolean;
}

/**
 * Member Benefits Banner Component
 * Displays the banner image at the bottom of the member benefits section
 * 
 * @param {MemberBenefitsBannerProps} props - Component props
 * @returns {JSX.Element} Banner image component
 */
export function MemberBenefitsBanner({ 
  className = '', 
  priority = false 
}: MemberBenefitsBannerProps): JSX.Element {
  return (
    <div className={`relative w-full ${className}`}>
      <Image
        src="/images/member-benefits-banner.png"
        alt="Member Benefits - Unlock exclusive rewards and perks"
        width={1200}
        height={300}
        priority={priority}
        className="w-full h-auto object-cover rounded-lg"
        placeholder="blur"
        blurDataURL="data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mNk+M9QDwADhgGAWjR9awAAAABJRU5ErkJggg=="
      />
    </div>
  );
}
```

**Instructions for adding the actual PNG file:**

1. Place the actual `member-benefits-banner.png` file in `public/images/` directory
2. Recommended dimensions: 1200x300px (4:1 aspect ratio)
3. Optimize the image using tools like TinyPNG or ImageOptim
4. Ensure file size is under 200KB for optimal performance
5. Use WebP format as alternative for better compression

**Note:** Binary image files cannot be generated as code. Please obtain the actual design asset from your design team and place it in the `public/images/` directory following the structure above.